PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fraudscope?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development
ML_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- ML layers (Isolation Forest + GNN + risk fusion); all optional, the app runs without them ---
# ML_ENABLED=false            # switch the ML layers off entirely
# ML_TIMEOUT_MS=1500          # per-call timeout to the ML service
# GNN_PREDICT_MS=5000         # how often the GNN analysis cycle runs
# GNN_ALERT_MIN_SCORE=70      # minimum GNN score to open a GNN_ACCOUNT_RISK alert
# FUSION_WEIGHTS={"rules":0.5,"isolation_forest":0.2,"gnn":0.3}
